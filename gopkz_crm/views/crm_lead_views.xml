<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="crm_lead_view_form_gopkz" model="ir.ui.view">
        <field name="name">crm.lead.view.form.gopkz</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">

            <!--
                Load all pipeline-gate helpers right after lead_info so the
                client has them for every lead type.
            -->
            <xpath expr="//group[@name='lead_info']" position="after">
                <field name="is_pipeline_editor"       invisible="1"/>
                <field name="is_hot_lead_recovery"     invisible="1"/>
                <field name="is_vendor_onboarding"     invisible="1"/>
                <field name="is_corporate_sales"       invisible="1"/>
                <field name="x_is_agreement_or_later"  invisible="1"/>
                <field name="x_can_approve"            invisible="1"/>
                <field name="x_all_attachments_submitted" invisible="1"/>
                <field name="x_partner_is_business"    invisible="1"/>
            </xpath>

            <!--
                Vendor field — shown below the Contact (partner_id) in the
                opportunity partner group whenever the contact is a Business
                (has a Service Type).  Auto-filled from partner_id.parent_id.
            -->
            <xpath expr="//group[@name='opportunity_partner']/field[@name='partner_id']"
                   position="after">
                <field name="x_vendor_id"
                       string="Vendor"
                       invisible="not x_partner_is_business"
                       options="{'no_create': True, 'no_create_edit': True}"/>
            </xpath>

            <!--
                Add Pipeline (team_id), Customer Type, Booking ID, Destinations
                and travel dates to the opportunity right-column group.
            -->
            <xpath expr="//group[@invisible=&quot;type == 'lead'&quot;]/field[@name='tag_ids']" position="after">
                <field name="team_id"
                       string="Pipeline"
                       options="{'no_open': True, 'no_create': True}"
                       readonly="not is_pipeline_editor"/>
                <field name="hlr_customer_type"
                       string="Customer Type"
                       invisible="not is_hot_lead_recovery"/>
                <field name="x_payment_status"
                       string="Payment Status"
                       invisible="not is_hot_lead_recovery"/>
                <field name="x_business_channel"
                       string="Business Channel"
                       invisible="not is_vendor_onboarding"/>
                <field name="booking_id" string="Booking ID" readonly="1"
                       invisible="not is_hot_lead_recovery"/>
                <field name="hlr_destination_ids"
                       string="Destinations"
                       widget="many2many_tags"
                       readonly="1"
                       invisible="not is_hot_lead_recovery"/>
                <field name="hlr_travel_date_from"
                       string="Travel From"
                       readonly="1"
                       invisible="not is_hot_lead_recovery"/>
                <field name="hlr_travel_date_to"
                       string="Travel To"
                       readonly="1"
                       invisible="not is_hot_lead_recovery"/>
            </xpath>

            <!-- booking_id in the lead-type right-column group: HLR only -->
            <xpath expr="//group[@invisible=&quot;type == 'opportunity'&quot;]/field[@name='team_id']" position="after">
                <field name="booking_id" string="Booking ID" readonly="1"
                       invisible="not is_hot_lead_recovery"/>
            </xpath>

            <!-- Relabel and restrict team_id in the LEAD right-column group -->
            <xpath expr="//group[@invisible=&quot;type == 'opportunity'&quot;]/field[@name='team_id']" position="attributes">
                <attribute name="string">Pipeline</attribute>
                <attribute name="readonly">not is_pipeline_editor</attribute>
            </xpath>

            <!-- Contacts tab → Ownership group: team_id read-only -->
            <xpath expr="//group[@name='Misc']/field[@name='team_id']" position="attributes">
                <attribute name="string">Pipeline</attribute>
                <attribute name="readonly">1</attribute>
            </xpath>

            <!--
                Hide Expected Revenue for Vendor Onboarding and Corporate Sales
                pipelines — these are process pipelines, not sales pipelines.
                We target the containing div (which is already invisible for leads).
            -->
            <xpath expr="//div[@invisible=&quot;type == 'lead'&quot;][.//field[@name='expected_revenue']]" position="attributes">
                <attribute name="invisible">type == 'lead' or is_vendor_onboarding or is_corporate_sales</attribute>
            </xpath>

            <!-- lost_reason_id: read-only once lost -->
            <xpath expr="//field[@name='lost_reason_id']" position="attributes">
                <attribute name="readonly">won_status == 'lost'</attribute>
            </xpath>

            <!-- Other Reason Detail: show only when lost + Other reason -->
            <xpath expr="//field[@name='lost_reason_id']" position="after">
                <field name="x_is_lost_other" invisible="1"/>
                <field name="x_lost_reason_detail"
                       string="Other Reason Detail"
                       readonly="1"
                       invisible="won_status != 'lost' or not x_is_lost_other"/>
            </xpath>

            <!-- ── Notebook pages ─────────────────────────────────────────── -->
            <xpath expr="//notebook" position="inside">

                <!-- ── Hot Lead Recovery: Business / Vendor capture ──────── -->
                <page string="Vendors" name="hlr_vendors"
                      invisible="not is_hot_lead_recovery">
                    <field name="hlr_vendor_line_ids">
                        <list editable="bottom">
                            <field name="currency_id" column_invisible="1"/>
                            <field name="vendor_id" string="Business"/>
                            <field name="vendor_category_id"
                                   string="Service Type"
                                   readonly="1"/>
                            <field name="destination_id" string="Destination"/>
                            <field name="service_date_from" string="Check-in / Travel Date"/>
                            <field name="service_date_to" string="Check-out / Return Date"/>
                            <field name="commission_pct" string="Commission %"/>
                            <field name="vendor_amount"
                                   string="Vendor Amount"
                                   sum="Total"/>
                            <field name="commission_amount"
                                   string="Commission"
                                   readonly="1"
                                   sum="Total"/>
                            <field name="payable_vendor_amount"
                                   string="Payable to Vendor"
                                   readonly="1"
                                   sum="Total"/>
                        </list>
                    </field>
                    <group invisible="not is_hot_lead_recovery">
                        <group string="Totals">
                            <field name="hlr_total_vendor_amount" readonly="1"/>
                            <field name="hlr_total_commission" readonly="1"/>
                            <field name="hlr_total_payable_vendor" readonly="1"/>
                        </group>
                    </group>
                </page>

                <!-- ── Hot Lead Recovery: Refund Policy ──────────────────── -->
                <page string="Refund Policy" name="hlr_refund_policy"
                      invisible="not is_hot_lead_recovery">
                    <field name="x_refund_policy" nolabel="1"/>
                </page>

                <!-- ── Vendor Onboarding: Agreement Attachments ──────────── -->
                <!--
                    Visible from the Agreement stage onward (x_is_agreement_or_later).
                    Each attachment section has:
                      • A URL field (hyperlink)
                      • A Submit button — hidden until a URL is entered, hidden after
                        submission
                      • A "Submitted" badge shown after submission
                    Once all three are submitted the Approve button appears for the
                    Operations Manager.
                -->
                <page string="Attachments" name="gopkz_attachments"
                      invisible="not x_is_agreement_or_later">

                    <group string="Signed Agreement">
                        <field name="x_attachment_agreement_url"
                               string="Hyperlink"
                               readonly="x_attachment_agreement_submitted"
                               placeholder="https://…"/>
                        <field name="x_attachment_agreement_submitted"
                               string="Submitted"
                               readonly="1"
                               invisible="not x_attachment_agreement_submitted"/>
                        <button name="action_submit_agreement"
                                type="object"
                                string="Submit"
                                class="btn-primary"
                                invisible="not x_attachment_agreement_url or x_attachment_agreement_submitted"/>
                    </group>

                    <group string="Pictures">
                        <field name="x_attachment_pictures_url"
                               string="Hyperlink"
                               readonly="x_attachment_pictures_submitted"
                               placeholder="https://…"/>
                        <field name="x_attachment_pictures_submitted"
                               string="Submitted"
                               readonly="1"
                               invisible="not x_attachment_pictures_submitted"/>
                        <button name="action_submit_pictures"
                                type="object"
                                string="Submit"
                                class="btn-primary"
                                invisible="not x_attachment_pictures_url or x_attachment_pictures_submitted"/>
                    </group>

                    <group string="Other Documentation">
                        <field name="x_attachment_other_url"
                               string="Hyperlink"
                               readonly="x_attachment_other_submitted"
                               placeholder="https://…"/>
                        <field name="x_attachment_other_submitted"
                               string="Submitted"
                               readonly="1"
                               invisible="not x_attachment_other_submitted"/>
                        <button name="action_submit_other"
                                type="object"
                                string="Submit"
                                class="btn-primary"
                                invisible="not x_attachment_other_url or x_attachment_other_submitted"/>
                    </group>

                    <group invisible="not x_all_attachments_submitted">
                        <group string="Approval">
                            <field name="x_agreement_approved"
                                   string="Agreement Approved"
                                   readonly="1"/>
                            <button name="action_approve_agreement"
                                    type="object"
                                    string="Approve &amp; Advance to Onboarding"
                                    class="btn-success"
                                    invisible="x_agreement_approved or not x_can_approve"/>
                            <field name="x_can_approve" invisible="1"/>
                        </group>
                    </group>

                </page>

                <!-- ── Vendor Onboarding: Vendor Scoring ─────────────────── -->
                <page string="Vendor Scoring" name="vendor_scoring"
                      invisible="not is_vendor_onboarding">

                    <field name="scoring_locked" invisible="1"/>

                    <group>
                        <group string="Service Type &amp; Score">
                            <field name="vendor_category_id"
                                   string="Service Type"
                                   readonly="scoring_locked"/>
                            <field name="total_score" readonly="1"/>
                            <field name="score_tier" readonly="1"/>
                        </group>
                        <group string="Scoring Status">
                            <field name="scoring_confirmed" readonly="1"/>
                            <button
                                name="action_confirm_scoring"
                                string="Confirm Scoring"
                                type="object"
                                class="btn-success"
                                invisible="not vendor_category_id or scoring_confirmed or scoring_locked"
                            />
                        </group>
                    </group>

                    <field name="score_line_ids"
                           invisible="not vendor_category_id"
                           create="0"
                           delete="0">
                        <list editable="bottom" create="0" delete="0">
                            <field name="criteria_id"
                                   readonly="1"
                                   force_save="1"
                                   string="Criterion"/>
                            <field name="weight"
                                   readonly="1"
                                   string="Weight (%)"/>
                            <field name="score"
                                   string="Score (0–100)"
                                   digits="[6,2]"
                                   readonly="parent.scoring_locked"/>
                            <field name="score_entered"
                                   string="Scored"
                                   readonly="parent.scoring_locked"/>
                            <field name="weighted_score"
                                   readonly="1"
                                   string="Weighted Score"/>
                        </list>
                    </field>

                </page>
            </xpath>

        </field>
    </record>

    <!-- Lead / opportunity search view: HLR travel-date filters -->
    <record id="crm_lead_view_search_gopkz" model="ir.ui.view">
        <field name="name">crm.lead.view.search.gopkz</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.view_crm_case_leads_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <field name="hlr_travel_date_from" string="Travel From"/>
                <field name="hlr_travel_date_to" string="Travel To"/>
                <filter string="Has Travel Dates"
                        name="filter_hlr_travel_dates"
                        domain="[('hlr_travel_date_from', '!=', False)]"/>
            </xpath>
        </field>
    </record>

</odoo>
