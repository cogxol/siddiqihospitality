<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="crm_lead_view_form_gopkz" model="ir.ui.view">
        <field name="name">crm.lead.view.form.gopkz</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">

            <!--
                Declare is_pipeline_editor and is_hot_lead_recovery right after
                the lead_info group so the client loads their values for all
                lead/opportunity types.
                Both fields are always invisible — they are only used to gate
                readonly/invisible attributes on other fields.
            -->
            <xpath expr="//group[@name='lead_info']" position="after">
                <field name="is_pipeline_editor" invisible="1"/>
                <field name="is_hot_lead_recovery" invisible="1"/>
            </xpath>

            <!--
                Add "Pipeline" (team_id) to the OPPORTUNITY right-column group.
                The standard form has team_id in the Contacts tab for
                opportunities, which is not visible on first open.
                This adds a prominently placed read (for all) / write (admin)
                copy in the main info area.
                readonly="not is_pipeline_editor" → editable only by sysadmin.
            -->
            <xpath expr="//group[@invisible=&quot;type == 'lead'&quot;]/field[@name='tag_ids']" position="after">
                <field name="team_id"
                       string="Pipeline"
                       options="{'no_open': True, 'no_create': True}"
                       readonly="not is_pipeline_editor"/>
                <field name="hlr_customer_type"
                       string="Customer Type"
                       invisible="not is_hot_lead_recovery"/>
                <field name="booking_id" string="Booking ID" readonly="1"/>
            </xpath>

            <!-- booking_id also in the lead-type right-column group -->
            <xpath expr="//group[@invisible=&quot;type == 'opportunity'&quot;]/field[@name='team_id']" position="after">
                <field name="booking_id" string="Booking ID" readonly="1"/>
            </xpath>

            <!--
                Relabel and restrict the team_id that is in the LEAD right-
                column group (visible when type == 'lead').
            -->
            <xpath expr="//group[@invisible=&quot;type == 'opportunity'&quot;]/field[@name='team_id']" position="attributes">
                <attribute name="string">Pipeline</attribute>
                <attribute name="readonly">not is_pipeline_editor</attribute>
            </xpath>

            <!--
                The Contacts tab → Ownership group also shows team_id.
                Mark it always readonly there: the right-column field above
                is the single authoritative edit point for admins; this copy
                is purely informational.
            -->
            <xpath expr="//group[@name='Misc']/field[@name='team_id']" position="attributes">
                <attribute name="string">Pipeline</attribute>
                <attribute name="readonly">1</attribute>
            </xpath>

            <!--
                Make lost_reason_id read-only once the lead is lost.
                won_status == 'lost' means active=False (archived by Mark Lost).
                After restore, won_status returns to 'pending' so the field
                becomes editable again (and Odoo also clears lost_reason_id
                on restore, so it's invisible anyway).
            -->
            <xpath expr="//field[@name='lost_reason_id']" position="attributes">
                <attribute name="readonly">won_status == 'lost'</attribute>
            </xpath>

            <!--
                Show x_lost_reason_detail only when:
                  - The lead is lost (won_status == 'lost')
                  - The reason is specifically "Other" (x_is_lost_other)
                x_is_lost_other is a non-stored computed Boolean on crm.lead
                that checks lost_reason_id against gopkz_crm.lost_reason_other.
            -->
            <xpath expr="//field[@name='lost_reason_id']" position="after">
                <field name="x_is_lost_other" invisible="1"/>
                <field name="x_lost_reason_detail"
                       string="Other Reason Detail"
                       readonly="1"
                       invisible="won_status != 'lost' or not x_is_lost_other"/>
            </xpath>

            <!--
                Add a "Vendor Scoring" page to the lead form notebook.
                The page is only visible when the lead belongs to the
                Vendor Onboarding team (is_vendor_onboarding = True).

                is_vendor_onboarding and scoring_locked are non-stored
                computed fields; both must be present in the view (even if
                invisible) so the client loads and re-evaluates them on
                field changes.

                scoring_locked becomes True once the lead has advanced past
                Qualifying — at that point the Score column becomes readonly
                (parent.scoring_locked) and Confirm Scoring is hidden.

                score_line_ids:
                  - create="0" delete="0" on BOTH the outer <field> and the
                    inner <list> per Section 12 of the spec.
                  - criteria_id carries force_save="1" per Section 0.1.
                  - score is readonly when parent.scoring_locked (past
                    Qualifying in the VO pipeline).
            -->
            <xpath expr="//notebook" position="inside">

                <!-- ── Hot Lead Recovery: Vendor capture ─────────────────── -->
                <page string="Vendors" name="hlr_vendors"
                      invisible="not is_hot_lead_recovery">
                    <field name="hlr_vendor_line_ids">
                        <list editable="bottom">
                            <field name="vendor_id" string="Vendor"/>
                            <field name="vendor_category_id"
                                   string="Vendor Category"
                                   readonly="1"/>
                        </list>
                    </field>
                </page>

                <page string="Vendor Scoring" name="vendor_scoring"
                      invisible="not is_vendor_onboarding">

                    <!-- Non-stored helpers loaded by the client. -->
                    <field name="is_vendor_onboarding" invisible="1"/>
                    <field name="scoring_locked" invisible="1"/>

                    <group>
                        <group string="Category &amp; Score">
                            <field name="vendor_category_id"
                                   readonly="scoring_locked"/>
                            <field name="total_score" readonly="1"/>
                            <field name="score_tier" readonly="1"/>
                        </group>
                        <group string="Scoring Status">
                            <field name="scoring_confirmed" readonly="1"/>
                            <button
                                name="action_confirm_scoring"
                                string="Confirm Scoring"
                                type="object"
                                class="btn-success"
                                invisible="not vendor_category_id or scoring_confirmed or scoring_locked"
                            />
                        </group>
                    </group>

                    <field name="score_line_ids"
                           invisible="not vendor_category_id"
                           create="0"
                           delete="0">
                        <list editable="bottom" create="0" delete="0">
                            <field name="criteria_id"
                                   readonly="1"
                                   force_save="1"
                                   string="Criterion"/>
                            <field name="weight"
                                   readonly="1"
                                   string="Weight (%)"/>
                            <field name="score"
                                   string="Score (0–100)"
                                   digits="[6,2]"
                                   readonly="parent.scoring_locked"/>
                            <field name="score_entered"
                                   invisible="1"/>
                            <field name="weighted_score"
                                   readonly="1"
                                   string="Weighted Score"/>
                        </list>
                    </field>

                </page>
            </xpath>

        </field>
    </record>
</odoo>
