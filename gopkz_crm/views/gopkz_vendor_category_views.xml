<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List view -->
    <record id="view_gopkz_vendor_category_list" model="ir.ui.view">
        <field name="name">gopkz.vendor.category.list</field>
        <field name="model">gopkz.vendor.category</field>
        <field name="arch" type="xml">
            <list string="Service Types" editable="top">
                <field name="name"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <!-- Form view -->
    <record id="view_gopkz_vendor_category_form" model="ir.ui.view">
        <field name="name">gopkz.vendor.category.form</field>
        <field name="model">gopkz.vendor.category</field>
        <field name="arch" type="xml">
            <form string="Service Type">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_gopkz_vendor_category" model="ir.actions.act_window">
        <field name="name">Service Types</field>
        <field name="res_model">gopkz.vendor.category</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'active_test': False}</field>
    </record>
</odoo>
