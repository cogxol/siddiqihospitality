<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List view -->
    <record id="view_gopkz_scoring_criteria_list" model="ir.ui.view">
        <field name="name">gopkz.scoring.criteria.list</field>
        <field name="model">gopkz.scoring.criteria</field>
        <field name="arch" type="xml">
            <list string="Scoring Criteria">
                <field name="category_id"/>
                <field name="name"/>
                <field name="weight"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <!-- Form view -->
    <record id="view_gopkz_scoring_criteria_form" model="ir.ui.view">
        <field name="name">gopkz.scoring.criteria.form</field>
        <field name="model">gopkz.scoring.criteria</field>
        <field name="arch" type="xml">
            <form string="Scoring Criterion">
                <sheet>
                    <group>
                        <field name="category_id"/>
                        <field name="name"/>
                        <field name="weight"/>
                        <field name="sequence"/>
                        <field name="active"/>
                    </group>
                    <group string="Evaluation Guide">
                        <field name="evaluation_guide" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_gopkz_scoring_criteria" model="ir.actions.act_window">
        <field name="name">Scoring Criteria</field>
        <field name="res_model">gopkz.scoring.criteria</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'active_test': False}</field>
    </record>
</odoo>
