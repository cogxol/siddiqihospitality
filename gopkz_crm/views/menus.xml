<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        gopkz CRM configuration menu items under CRM > Configuration.
        "Vendor Categories" is now the Service Types list (same model, renamed).
        The legacy gopkz.service.type menu is removed — vendor_category_id is
        the canonical service type going forward.
    -->
    <menuitem
        id="menu_gopkz_vendor_categories"
        name="Service Types"
        parent="crm.crm_menu_config"
        action="gopkz_crm.action_gopkz_vendor_category"
        sequence="50"/>

    <menuitem
        id="menu_gopkz_scoring_criteria"
        name="Scoring Criteria"
        parent="crm.crm_menu_config"
        action="gopkz_crm.action_gopkz_scoring_criteria"
        sequence="51"/>

    <menuitem
        id="menu_gopkz_destinations"
        name="Destinations"
        parent="crm.crm_menu_config"
        action="gopkz_crm.action_gopkz_destination"
        sequence="52"/>
</odoo>
