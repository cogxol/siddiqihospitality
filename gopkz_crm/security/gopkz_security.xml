<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!--
        Vendor Manager group — grants full CRUD on gopkz master data models.
        Administrators have system-wide access and don't need to be added here.
        Assign Vendor Onboarding team members to this group via Settings → Users
        to give them write/create access to categories, criteria, destinations
        and score lines.
    -->
    <record id="group_vendor_manager" model="res.groups">
        <field name="name">Vendor Manager</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
</odoo>
