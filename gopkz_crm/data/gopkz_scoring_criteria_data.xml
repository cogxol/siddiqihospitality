<?xml version="1.0" encoding="utf-8"?>
<!-- Scoring criteria per vendor category.  Weights sum to 100 for each category.
     Hotel (7 criteria): 20+20+20+15+10+10+5 = 100
     Car Rental (8 criteria): 20+20+15+15+10+10+5+5 = 100
     Tour (8 criteria): 20+15+15+15+10+10+10+5 = 100
     Experience (8 criteria): 25+20+15+15+10+5+5+5 = 100  -->
<odoo noupdate="1">

    <!-- ── Hotel ────────────────────────────────────────────────────────── -->
    <record id="criteria_hotel_adr" model="gopkz.scoring.criteria">
        <field name="name">ADR / Price Positioning</field>
        <field name="category_id" ref="gopkz_crm.vendor_cat_hotel"/>
        <field name="sequence">10</field>
        <field name="weight">20</field>
    </record>
    <record id="criteria_hotel_location" model="gopkz.scoring.criteria">
        <field name="name">Location</field>
