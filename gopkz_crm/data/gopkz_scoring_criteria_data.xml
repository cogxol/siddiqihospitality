        <field name="weight">20</field>
    </record>
    <record id="criteria_hotel_demand" model="gopkz.scoring.criteria">
        <field name="name">Demand Potential</field>
        <field name="category_id" ref="gopkz_crm.vendor_cat_hotel"/>
