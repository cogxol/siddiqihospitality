<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!--
        Daily cron that advances Customer Experience (Track B) tickets:
            Pre-Travel Support  → During Travel Support  (travel_date_from reached)
            During Travel Support → Post-Service Support  (travel_date_to passed)

        Post-Service → Feedback is deliberately NOT automated (BRD §3.3).
    -->
    <record id="ir_cron_progress_travel_support" model="ir.cron">
        <field name="name">GOPKZ CX: Progress Travel Support Tickets</field>
        <field name="model_id" ref="helpdesk.model_helpdesk_ticket"/>
        <field name="state">code</field>
        <field name="code">model._cron_progress_travel_support()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
        <field name="priority">5</field>
    </record>
</odoo>
